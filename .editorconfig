root = true

[*.cs]
# 覆盖官方默认的 4 空格，改为 2 空格缩进
indent_size = 2

# 统一跨平台换行符为 LF（官方默认跟随系统，如 Windows 的 CRLF）
end_of_line = lf

# 自动清理行尾空格与补全末尾空行（官方默认均为 false）
insert_final_newline = true
trim_trailing_whitespace = true

# 开启 C# 10+ 文件范围命名空间（官方默认仍为传统大括号块级命名空间）
csharp_style_namespace_declarations = file_scoped:warning 

# 强制要求所有控制流（if、else、for 等）必须添加花括号
csharp_prefer_braces = true:warning