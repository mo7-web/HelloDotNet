<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 编译目标：指定为可执行文件（控制台应用/Web 服务入口） -->
    <OutputType>Exe</OutputType>
    <!-- 运行环境：使用 .NET 10.0 运行时环境 -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- 可空引用类型：开启编译器空值检查（有助于在编译阶段捕获 NullReferenceException 隐患） -->
    <Nullable>enable</Nullable>
    <!-- Native AOT 编译：发布时直接编译为原生机器码，无需依赖 JIT。同时会自动触发全代码裁剪（Full Trimming） -->
    <PublishAot>true</PublishAot>
    <!-- 剥离调试符号：Release 发布时剥离二进制文件中的调试符号（PDB），进一步缩小最终的可执行文件体积 -->
    <StripSymbols>true</StripSymbols>
    <!-- 禁用全球化库：移除 ICU 语言数据库依赖。仅使用 UTC/Invariant 规则，可直接节省 20MB~30MB 镜像体积与内存 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 允许 Unsafe 代码块：开启对指针和直接内存操作的支持（高性能场景按需启用，默认禁用） -->
    <!-- <AllowUnsafeBlocks>true</AllowUnsafeBlocks> -->
  </PropertyGroup>
</Project>
