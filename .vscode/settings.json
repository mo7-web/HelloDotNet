{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes, .gitmodules, .stignore, .nomedia",
    "README.md": "*.md",
    "package.json": "*.json, *.yaml, *.yml, *.toml, .env, go.mod, go.sum, config.*, *config.ts, eslint*, .eslint*, .prettier*, *.d.ts, *lock, *json.md5, .browserslistrc"
  },

  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "files.exclude": {
    // ".vscode": true, // 隐藏文件夹
    // "node_modules": true, // 隐藏文件夹
    // ".stfolder": true,
    // ".obsidian": true
  },
  "cSpell.words": ["Avalonia", "csharp", "dotnet"],
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  }
}
