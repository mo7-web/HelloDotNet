{
  // 文件嵌套展示规则
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes, .gitmodules, .stignore, .nomedia",
    "README.md": "*.md",
    "package.json": "*.json, *.yaml, *.yml, *.toml, .env, *config.ts, eslint*, .prettier*"
  },

  // 基础通用设置
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "files.exclude": {
    // "node_modules": true, // 隐藏文件夹
  },

  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },

  "cSpell.words": [
    // 拼写检查忽略词
    "Avalonia",
    "csharp",
    "csharpier",
    "dotnet",
    "slnx",
    "csproj",
    "axaml"
  ]
}
